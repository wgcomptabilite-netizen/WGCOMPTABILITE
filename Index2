<nav>
  <div class="logo">W<span>&</span>G Comptabilité</div>
  <div class="nav-right">
    <ul>
      <li><a href="#services" data-fr="Services" data-en="Services">Services</a></li>
      <li><a href="#avantage" data-fr="L'avantage" data-en="The edge">L'avantage</a></li>
      <li><a href="#approche" data-fr="Approche" data-en="Approach">Approche</a></li>
      <li><a href="#contact" data-fr="Contact" data-en="Contact">Contact</a></li>
    </ul>
    <div class="lang-toggle">
      <button class="lang-btn active" onclick="setLang('fr')">FR</button>
      <div class="lang-divider"></div>
      <button class="lang-btn" onclick="setLang('en')">EN</button>
    </div>
  </div>
</nav>

<!-- HERO -->
