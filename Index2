<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>W&G Comptabilité</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --navy: #0e1b2e;
    --navy-mid: #162440;
    --gold: #b89a5a;
    --gold-light: #d4b87a;
    --cream: #f8f5ef;
    --cream-dark: #ede8df;
    --text-muted: #7a7060;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--cream);
    color: var(--navy);
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* NAV */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 3rem;
    background: rgba(248,245,239,0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(184,154,90,0.18);
  }

  .logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--navy);
  }

  .logo span { color: var(--gold); }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: 2.5rem;
  }

  nav a {
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  nav a:hover { color: var(--gold); }

  /* LANG TOGGLE */
  .lang-toggle {
    display: flex;
    align-items: center;
    border: 1px solid rgba(184,154,90,0.35);
    overflow: hidden;
  }

  .lang-btn {
    background: none;
    border: none;
    padding: 0.35rem 0.75rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    cursor: pointer;
    transition: background 0.18s, color 0.18s;
  }

  .lang-btn.active {
    background: var(--gold);
    color: var(--navy);
  }

  .lang-divider {
    width: 1px;
    height: 18px;
    background: rgba(184,154,90,0.35);
  }

  /* HERO */
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-top: 5rem;
  }

  .hero-left {
    background: var(--navy);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 6rem 5rem;
    position: relative;
    overflow: hidden;
  }

  .hero-left::before {
    content: '';
    position: absolute;
    top: -80px; right: -80px;
    width: 360px; height: 360px;
    border-radius: 50%;
    border: 1px solid rgba(184,154,90,0.12);
  }

  .hero-left::after {
    content: '';
    position: absolute;
    bottom: -40px; left: -60px;
    width: 240px; height: 240px;
    border-radius: 50%;
    border: 1px solid rgba(184,154,90,0.08);
  }

  .eyebrow {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.5rem;
    position: relative;
  }

  .hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(3rem, 5vw, 4.5rem);
    font-weight: 300;
    line-height: 1.1;
    color: var(--cream);
    margin-bottom: 1rem;
    position: relative;
  }

  .hero-title em {
    font-style: italic;
    color: var(--gold-light);
  }

  .hero-subtitle {
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(248,245,239,0.55);
    margin-bottom: 2.5rem;
    max-width: 360px;
    position: relative;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex-wrap: wrap;
    position: relative;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--gold);
    color: var(--navy);
    padding: 0.9rem 2rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
    width: fit-content;
  }

  .cta-btn:hover { background: var(--gold-light); transform: translateY(-1px); }
  .cta-btn svg { transition: transform 0.2s; }
  .cta-btn:hover svg { transform: translateX(3px); }

  .cta-ghost {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(248,245,239,0.7);
    text-decoration: none;
    border-bottom: 1px solid rgba(184,154,90,0.4);
    padding-bottom: 3px;
    transition: color 0.2s, border-color 0.2s;
  }

  .cta-ghost:hover { color: var(--gold-light); border-color: var(--gold-light); }

  .hero-right {
    background: var(--cream-dark);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 6rem 4rem;
    text-align: center;
  }

  .monogram {
    width: 120px; height: 120px;
    border: 1px solid var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 2.5rem;
    position: relative;
  }

  .monogram::before {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px solid rgba(184,154,90,0.3);
  }

  .monogram span {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.5rem;
    font-weight: 600;
    color: var(--gold);
    letter-spacing: 0.05em;
  }

  .tagline {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    font-weight: 300;
    font-style: italic;
    color: var(--navy);
    margin-bottom: 0.75rem;
  }

  .tagline-sub {
    font-size: 0.8rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .divider {
    width: 40px;
    height: 1px;
    background: var(--gold);
    margin: 1.5rem auto;
  }

  .contact-pills {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 2rem;
    text-align: left;
    width: 100%;
    max-width: 260px;
  }

  .pill {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .pill-icon {
    width: 28px; height: 28px;
    border: 1px solid rgba(184,154,90,0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .pill-icon svg { width: 13px; height: 13px; stroke: var(--gold); fill: none; stroke-width: 1.5; }

  /* SECTION SHELLS */
  .section-header {
    display: flex;
    align-items: baseline;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .section-label {
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    white-space: nowrap;
  }

  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.8rem;
    font-weight: 300;
    color: var(--navy);
    line-height: 1.1;
  }

  /* SERVICES */
  .services {
    padding: 7rem 5rem;
    background: var(--cream);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgba(14,27,46,0.12);
    border: 1px solid rgba(14,27,46,0.12);
  }

  .service-card {
    background: var(--cream);
    padding: 2.5rem 2rem;
    transition: background 0.25s;
    cursor: default;
  }

  .service-card:hover { background: var(--navy); }
  .service-card:hover .svc-num, .service-card:hover .svc-name { color: var(--cream); }
  .service-card:hover .svc-desc { color: rgba(248,245,239,0.5); }
  .service-card:hover .svc-line { background: var(--gold); }

  .svc-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.75rem;
    color: var(--gold);
    letter-spacing: 0.15em;
    margin-bottom: 2rem;
    display: block;
    transition: color 0.25s;
  }

  .svc-line {
    width: 24px; height: 1px;
    background: rgba(184,154,90,0.4);
    margin-bottom: 1.25rem;
    transition: background 0.25s;
  }

  .svc-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--navy);
    line-height: 1.2;
    margin-bottom: 1rem;
    transition: color 0.25s;
  }

  .svc-desc {
    font-size: 0.78rem;
    line-height: 1.8;
    color: var(--text-muted);
    transition: color 0.25s;
  }

  /* ADVANTAGE */
  .advantage {
    background: var(--navy);
    padding: 7rem 5rem;
    position: relative;
    overflow: hidden;
  }

  .advantage::before {
    content: '';
    position: absolute;
    top: -120px; right: -120px;
    width: 420px; height: 420px;
    border-radius: 50%;
    border: 1px solid rgba(184,154,90,0.08);
  }

  .advantage .section-label { color: var(--gold); }
  .advantage .section-title { color: var(--cream); }

  .advantage-intro {
    max-width: 560px;
    margin-bottom: 4rem;
    position: relative;
  }

  .advantage-body {
    font-size: 0.9rem;
    line-height: 1.9;
    color: rgba(248,245,239,0.55);
    margin-top: 1.5rem;
  }

  .advantage-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: rgba(184,154,90,0.2);
    border: 1px solid rgba(184,154,90,0.2);
    position: relative;
  }

  .adv-card {
    background: var(--navy);
    padding: 2.75rem 2.5rem;
    transition: background 0.25s;
  }

  .adv-card:hover { background: var(--navy-mid); }

  .adv-icon {
    width: 40px; height: 40px;
    border: 1px solid rgba(184,154,90,0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.75rem;
  }

  .adv-icon svg { width: 18px; height: 18px; stroke: var(--gold); fill: none; stroke-width: 1.4; }

  .adv-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--cream);
    margin-bottom: 0.9rem;
  }

  .adv-desc {
    font-size: 0.82rem;
    line-height: 1.8;
    color: rgba(248,245,239,0.5);
  }

  /* APPROACH */
  .approach {
    padding: 7rem 5rem;
    background: var(--cream-dark);
  }

  .approach-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.5rem;
    margin-top: 4rem;
  }

  .step { position: relative; }

  .step-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.6rem;
    font-weight: 300;
    color: var(--gold);
    line-height: 1;
    margin-bottom: 1rem;
  }

  .step-line {
    width: 24px; height: 1px;
    background: rgba(184,154,90,0.5);
    margin-bottom: 1.1rem;
  }

  .step-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--navy);
    margin-bottom: 0.6rem;
  }

  .step-desc {
    font-size: 0.8rem;
    line-height: 1.75;
    color: var(--text-muted);
  }

  /* WHY */
  .why {
    background: var(--navy);
    padding: 7rem 5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .why-left .section-title { color: var(--cream); }
  .why-left .section-label { color: var(--gold); }

  .why-body {
    font-size: 0.9rem;
    line-height: 1.9;
    color: rgba(248,245,239,0.55);
    margin-top: 1.5rem;
  }

  .why-right {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .why-item {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(184,154,90,0.1);
  }

  .why-item:last-child { border-bottom: none; padding-bottom: 0; }

  .why-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    font-weight: 300;
    color: var(--gold);
    line-height: 1;
    flex-shrink: 0;
    width: 2.5rem;
  }

  .why-item-title {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--cream);
    margin-bottom: 0.4rem;
  }

  .why-item-desc {
    font-size: 0.78rem;
    line-height: 1.7;
    color: rgba(248,245,239,0.45);
  }

  /* CONTACT */
  .contact {
    padding: 7rem 5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: start;
  }

  .contact-detail {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .contact-label {
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .contact-val {
    font-size: 0.9rem;
    color: var(--navy);
  }

  .contact-form { display: flex; flex-direction: column; gap: 1.25rem; }

  .form-row { display: flex; flex-direction: column; gap: 0.4rem; }
  .form-label { font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); }

  input[type="text"], input[type="email"], textarea {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.88rem;
    padding: 0.75rem 1rem;
    border: 1px solid rgba(14,27,46,0.15);
    background: var(--cream-dark);
    color: var(--navy);
    outline: none;
    transition: border-color 0.2s;
    resize: none;
    width: 100%;
  }

  input:focus, textarea:focus { border-color: var(--gold); }

  .submit-btn {
    align-self: flex-start;
    background: var(--navy);
    color: var(--cream);
    border: none;
    padding: 0.9rem 2.25rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s;
  }

  .submit-btn:hover { background: var(--gold); color: var(--navy); }

  /* FOOTER */
  footer {
    background: var(--navy-mid);
    padding: 2rem 5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    border-top: 1px solid rgba(184,154,90,0.12);
  }

  .footer-logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    color: var(--cream);
    letter-spacing: 0.08em;
  }

  .footer-logo span { color: var(--gold); }

  .footer-copy {
    font-size: 0.72rem;
    color: rgba(248,245,239,0.3);
    letter-spacing: 0.08em;
  }

  .footer-cpa {
    font-size: 0.7rem;
    color: var(--gold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .reveal { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .reveal.visible { opacity: 1; transform: none; }

  [data-lang] { transition: opacity 0.2s; }

  /* RESPONSIVE — TABLET */
  @media (max-width: 1024px) {
    nav { padding: 1rem 1.75rem; }
    .nav-right { gap: 1.5rem; }
    nav ul { gap: 1.5rem; }

    .hero { grid-template-columns: 1fr; padding-top: 4.5rem; }
    .hero-left { padding: 4.5rem 2.5rem; }
    .hero-right { padding: 4rem 2.5rem; }

    .services, .advantage, .approach, .why, .contact { padding: 5rem 2.5rem; }

    .services-grid { grid-template-columns: repeat(2, 1fr); }
    .advantage-grid { grid-template-columns: repeat(2, 1fr); }
    .approach-steps { grid-template-columns: repeat(2, 1fr); gap: 2.5rem 2rem; }

    .why { grid-template-columns: 1fr; gap: 3rem; }
    .contact { grid-template-columns: 1fr; gap: 3rem; }
  }

  /* RESPONSIVE — PHONE */
  @media (max-width: 680px) {
    nav { padding: 0.9rem 1.25rem; }
    nav ul { display: none; }
    .logo { font-size: 1.15rem; }
    .nav-right { gap: 0; }

    .hero-left { padding: 3.5rem 1.5rem; }
    .hero-right { padding: 3.5rem 1.5rem; }
    .hero-title { font-size: clamp(2.4rem, 9vw, 3.1rem); }
    .hero-subtitle { max-width: none; }
    .hero-left::before { width: 240px; height: 240px; top: -60px; right: -60px; }

    .services, .advantage, .approach, .why, .contact { padding: 4rem 1.5rem; }

    .section-header { flex-direction: column; gap: 0.6rem; margin-bottom: 2.5rem; }
    .section-title { font-size: 2.05rem; }

    .services-grid, .advantage-grid, .approach-steps { grid-template-columns: 1fr; }
    .service-card { padding: 2rem 1.75rem; }
    .adv-card { padding: 2.25rem 1.75rem; }

    .advantage-intro { margin-bottom: 2.5rem; }

    footer { flex-direction: column; gap: 0.85rem; text-align: center; padding: 2.25rem 1.5rem; }
    .footer-cpa { order: 3; }
  }
</style>
</head>
